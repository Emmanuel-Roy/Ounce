# Build directories
build/
**/build/
build_pico1/
.bin/

# Temporary / OS / Python files
__pycache__/
*.pyc
.VSCode/
.idea/
*.user
*.suo

# VS Code local history, previously committed here by accident
.history/

# Captured video and input logs (bin/recordings, one level above the exe)
recordings/

# bin/client/OunceClient/ is committed deliberately - the point of bin/ is that you can
# clone and run without a toolchain. It is ~149MB across 181 files, so avoid
# rebuilding it in commits that do not need to change it.

# Specctra interchange files, regenerated from the board
*.dsn
*.ses

# KiCad lock files - one appears beside the project while it is open in KiCad
# and is deleted on close, so it only ever shows up mid-edit
*.lck
~*.lck

# KiCad backups and autosaves
*-backups/
_autosave-*
